# Copy to .env and edit. Read by ./start.sh, src/server/cache_warm.sh,
# src/pyserini/build_index.sh and docker compose. Variables already set in the
# shell take precedence over this file. Never commit .env (it is git-ignored).
#
# All paths are HOST paths. Relative paths are resolved from the repo root.

# ---- Artifacts the API serves (see SETUP.md) ----------------------------------
# Lucene index with "contents" and "title" fields (built with --fields title)
INDEX_DIR=./data/s2orc_index
# DOI -> record map from src/server/build_doi_map.py; optional (/doi returns 503 without it)
DOI_MAP_PATH=./data/doi_map.sqlite
# Where result records are read: s3 (default; one S3 range GET per record) or
# disk (byte offset into the local .jsonl files)
RAW_SOURCE=s3
# s3: record -> S3 byte-range map; src/server/download_from_s3.sh fetches it
RAW_S3_MAP_PATH=./data/raw_s3_map.sqlite
# disk: decompressed S2ORC .jsonl files; results are read back from them by byte offset
ORIGINAL_DATA_PATH=./data/s2orc_papers

# ---- Index building (src/pyserini/build_index.sh, `docker compose run index`) --
# Root for downloads, converted collections, the index and the DOI map
DATA_DIR=./data
# Semantic Scholar API key for src/s2orc/download_data.py
#S2_API_KEY=
# Parallelism: conversion workers and Lucene indexing threads
#CONVERT_WORKERS=8
#INDEX_THREADS=20

# ---- Serving (./start.sh) --------------------------------------------
HOST=0.0.0.0
PORT=8000
# gunicorn worker processes; one per two vCPUs, ~1.3 GB RAM each
WORKERS=16
# Bearer tokens, comma-separated ...
SCHOLAR_API_KEYS=
# ... and/or a file with one token per line ("#" comments allowed). With neither
# set, start.sh falls back to ~/.scholar/api_keys if it exists; with no keys at
# all the API is open and a warning is printed.
#SCHOLAR_API_KEYS_FILE=/home/me/.scholar/api_keys
# Title boost for index=all
#SCHOLAR_TITLE_WEIGHT=2.0
# Request threads per worker
#SCHOLAR_THREADS=40
# gunicorn log level
#LOG_LEVEL=info
